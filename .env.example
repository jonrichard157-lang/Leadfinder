# Supabase (Project Settings > API). Configure também em Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: Google Places API (New). Sem ela, a busca usa dados simulados.
GOOGLE_PLACES_API_KEY=

# Somente no servidor (NUNCA use o prefixo NEXT_PUBLIC_). Supabase > Project Settings > API > service_role.
# A rota de busca usa esta chave para gravar o catálogo de leads, que os usuários só podem ler.
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Suas integrações > sua aplicação > Credenciais). Somente no servidor.
# Use as credenciais de TESTE em Preview/local e as de PRODUÇÃO só no ambiente de produção.
MP_ACCESS_TOKEN=
# Suas integrações > Webhooks > Assinatura secreta (valida as notificações recebidas).
MP_WEBHOOK_SECRET=
# URL pública do app (https), usada nos retornos do checkout. Ex.: https://seu-dominio.com.br
APP_URL=
